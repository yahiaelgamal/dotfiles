# Example work git config — copy to ~/.gitconfig.local on work machines
# This overrides values in the shared .gitconfig

[user]
	name = Yahia Elgamal
	email = yahiae@spotify.com

# [commit]
#   gpgsign = true
#
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[maintenance]
	repo = /Users/yahiae/src/services-pilot
