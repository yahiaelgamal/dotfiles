{
  "env": {
    "PLAYWRIGHT_CHROME_EXECUTABLE_PATH": "/Applications/Arc.app/Contents/MacOS/Arc"
  },
  "permissions": {
    "allow": [
      "Bash(cd *)",
      "Bash(ls *)",
      "Bash(pwd)",
      "Bash(cat *)",
      "Bash(find *)",
      "Bash(which *)",
      "Bash(where *)",
      "Bash(echo *)",
      "Bash(gws *)",
      "Bash(gws * | python *)",
      "Bash(gws * | python3 *)",
      "Write(/tmp/*)",
      "Edit(/tmp/*)",
      "Read(/tmp/*)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch)",
      "Bash(npm test *)",
      "Bash(yarn test *)",
      "Bash(pytest *)",
      "Bash(npm run *)",
      "Bash(yarn *)",
      "Bash(python *)",
      "Bash(node *)",
      "Bash(make *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(wc *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(env)",
      "Bash(printenv *)",
      "Bash(man *)",
      "Bash(uv *)",
      "Bash(npm install *)",
      "Bash(brew *)",
      "Bash(watch *)",
      "WebSearch",
      "WebFetch",
      "Search"
    ],
    "defaultMode": "auto"
  },
  "model": "sonnet[1m]",
  "enabledPlugins": {
    "skill-creator@claude-plugins-official": true,
    "superpowers@claude-plugins-official": false,
    "pyright-lsp@claude-plugins-official": false
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "git",
        "url": "git@github.com:anthropics/claude-plugins-official.git"
      }
    }
  },
  "effortLevel": "low",
  "skipDangerousModePermissionPrompt": true,
  "skipAutoPermissionPrompt": true
}
